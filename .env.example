# Copy this file to .env and fill in values before running docker compose up

# Shared secret for all service-to-service calls
INTERNAL_TOKEN=changeme-replace-in-prod

# Grafana admin password
GRAFANA_PASSWORD=admin

# Wazuh container IP — fill in after setup_incus.sh completes:
#   incus info wazuh | grep -E "eth0|enp"
WAZUH_HOST=10.x.x.x

# Wazuh API credentials — reset to this known value by setup_incus.sh
# If the reset failed, check: incus exec wazuh -- cat /root/wazuh-install.log
WAZUH_PASS=Wazuh1234!

# Path where the Wazuh container's alerts.json is shared into the host.
# Set by setup_incus.sh via the shared disk device.
WAZUH_ALERTS_PATH=./logs/wazuh-alerts
