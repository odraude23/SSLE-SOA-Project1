{
  "title": "Smart City Overview",
  "uid": "smartcity-overview",
  "description": "Environmental monitoring — live sensor data per zone",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "tags": ["smartcity"],
  "panels": [
    {
      "id": 1, "type": "row", "title": "Zone AQI (Air Quality Index)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false
    },
    {
      "id": 2, "type": "stat", "title": "AQI — North",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 51},
              {"color": "orange", "value": 101},
              {"color": "red", "value": 201}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "smartcity_zone_aqi_avg{zone=\"north\"}",
        "instant": true, "legendFormat": "North"
      }]
    },
    {
      "id": 3, "type": "stat", "title": "AQI — Center",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 51},
              {"color": "orange", "value": 101},
              {"color": "red", "value": 201}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "smartcity_zone_aqi_avg{zone=\"center\"}",
        "instant": true, "legendFormat": "Center"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "AQI — South",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 51},
              {"color": "orange", "value": 101},
              {"color": "red", "value": 201}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "smartcity_zone_aqi_avg{zone=\"south\"}",
        "instant": true, "legendFormat": "South"
      }]
    },
    {
      "id": 5, "type": "row", "title": "Temperature & Noise",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "collapsed": false
    },
    {
      "id": 6, "type": "stat", "title": "Temperature °C — North",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 15}, {"color": "yellow", "value": 30}, {"color": "red", "value": 36}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_temp_avg{zone=\"north\"}", "instant": true, "legendFormat": "North"}]
    },
    {
      "id": 7, "type": "stat", "title": "Temperature °C — Center",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 15}, {"color": "yellow", "value": 30}, {"color": "red", "value": 36}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_temp_avg{zone=\"center\"}", "instant": true, "legendFormat": "Center"}]
    },
    {
      "id": 8, "type": "stat", "title": "Temperature °C — South",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 15}, {"color": "yellow", "value": 30}, {"color": "red", "value": 36}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_temp_avg{zone=\"south\"}", "instant": true, "legendFormat": "South"}]
    },
    {
      "id": 9, "type": "stat", "title": "Noise dB — North",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "dB", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 65}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_noise_avg{zone=\"north\"}", "instant": true, "legendFormat": "North"}]
    },
    {
      "id": 10, "type": "stat", "title": "Noise dB — Center",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "dB", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 65}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_noise_avg{zone=\"center\"}", "instant": true, "legendFormat": "Center"}]
    },
    {
      "id": 11, "type": "stat", "title": "Noise dB — South",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "dB", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 65}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus-uid"}, "expr": "smartcity_zone_noise_avg{zone=\"south\"}", "instant": true, "legendFormat": "South"}]
    },
    {
      "id": 12, "type": "row", "title": "Environmental Trends",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 10}, "collapsed": false
    },
    {
      "id": 13, "type": "timeseries", "title": "AQI over time — all zones",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineInterpolation": "smooth"}}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "smartcity_zone_aqi_avg",
        "legendFormat": "{{zone}}"
      }]
    },
    {
      "id": 14, "type": "timeseries", "title": "Temperature over time — all zones",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"lineInterpolation": "smooth"}}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "smartcity_zone_temp_avg",
        "legendFormat": "{{zone}}"
      }]
    },
    {
      "id": 15, "type": "row", "title": "Service Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19}, "collapsed": false
    },
    {
      "id": 16, "type": "timeseries", "title": "HTTP Request Rate — all services",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineInterpolation": "smooth"}}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "sum(rate(http_requests_total[1m])) by (job)",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 17, "type": "table", "title": "Service Up/Down",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 28},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}
                ]
              },
              {"id": "custom.displayMode", "value": "color-background"}
            ]
          }
        ]
      },
      "options": {"sortBy": [{"displayName": "Value", "desc": false}]},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "up",
        "instant": true,
        "legendFormat": "{{job}}"
      }],
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "columns"}},
        {"id": "organize", "options": {"renameByName": {"job": "Service", "Value": "Status"}}}
      ]
    },
    {
      "id": 18, "type": "row", "title": "Wazuh Security",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}, "collapsed": false
    },
    {
      "id": 19, "type": "stat", "title": "Wazuh API",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 35},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "wazuh_up",
        "instant": true,
        "legendFormat": "Wazuh API"
      }]
    },
    {
      "id": 20, "type": "stat", "title": "Active Agents",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 35},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": 0}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "wazuh_agents_active",
        "instant": true,
        "legendFormat": "Active Agents"
      }]
    },
    {
      "id": 21, "type": "stat", "title": "Total Alerts",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 35},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "sum(wazuh_alerts_total) or vector(0)",
        "instant": true,
        "legendFormat": "Total Alerts"
      }]
    },
    {
      "id": 22, "type": "table", "title": "Wazuh Daemon Status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "mappings", "value": [
                {"type": "value", "options": {"0": {"text": "stopped", "color": "red"}, "1": {"text": "running", "color": "green"}}}
              ]},
              {"id": "custom.displayMode", "value": "color-background"}
            ]
          }
        ]
      },
      "options": {"sortBy": [{"displayName": "daemon"}]},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "wazuh_manager_status",
        "instant": true,
        "legendFormat": "{{daemon}}"
      }],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "labelsToFields", "options": {"mode": "columns"}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
          "renameByName": {"daemon": "Daemon", "wazuh_manager_status": "Status", "Value": "Status"}
        }}
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Alert Rate (per rule)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "rate(wazuh_alerts_total[5m])",
        "legendFormat": "rule {{rule_id}} — {{description}}"
      }]
    },
    {
      "id": 24, "type": "timeseries", "title": "Alert Rate (per zone)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 43},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus-uid"},
        "expr": "sum by (zone) (rate(wazuh_alerts_total[5m]))",
        "legendFormat": "{{zone}}"
      }]
    }
  ]
}
