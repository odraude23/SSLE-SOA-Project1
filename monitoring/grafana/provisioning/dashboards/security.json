{
  "title": "Security Dashboard",
  "uid": "smartcity-security",
  "description": "Threat detection — DDoS, APT, Spam / Wazuh alerts",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
